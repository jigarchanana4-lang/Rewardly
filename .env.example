# ─── Rewardly environment ────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for QR codes, redirects, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth / OTP ─────────────────────────────────────────────────────────
# DEV_MODE=true short-circuits SMS: any phone accepts OTP "000000".
# Set false in production and configure a phone provider in Supabase Auth.
DEV_MODE=true
# MSG91 (production SMS OTP). Configure as the phone provider in Supabase,
# or wire directly in src/app/api/otp/* if you prefer.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ─── Razorpay ───────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Webhook secret (Razorpay dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# ─── Transactional email (Resend) ───────────────────────────────────────
# Blank / DEV_MODE=true → emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=Rewardly <onboarding@resend.dev>

# ─── Error monitoring (optional) ────────────────────────────────────────
SENTRY_DSN=

# ─── Web Push (VAPID) — M3 push notifications ───────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rewardly.example
# Optional: pre-created Razorpay Plan IDs per tier (subscriptions)
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# ─── WhatsApp Cloud API (broadcast campaigns) ───────────────────────────
# With DEV_MODE=true these can stay blank — sends are logged, not delivered.
# For real sends: Meta app → WhatsApp → API setup. Broadcasts need an APPROVED
# template with a single body parameter (the composed message is passed in).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANG=en
