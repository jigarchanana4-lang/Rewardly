# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT — Rewardly / Hospiminds Loyalty
#
# Copy each value into the Vercel project's Environment Variables (Production).
# NEXT_PUBLIC_* are INLINED AT BUILD TIME — after changing one you must
# REDEPLOY, not just save. This is the single most common go-live mistake.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Must be the PUBLIC url customers reach. Under multi-zone routing this is the
# Hospiminds address, NOT the raw *.vercel.app one — QR codes are generated
# from it and are effectively permanent once printed.
NEXT_PUBLIC_SITE_URL=https://app.hospiminds.com/loyalty

# Turns OFF all the "log instead of send" shims. MUST be false in production,
# or nothing bills, nothing messages, and no OTP is ever sent.
DEV_MODE=false

# ── Supabase ─────────────────────────────────────────────────────────────────
# A NEW project. Do not reuse the dead Hospiminds project (pdcyfanycdgkgagoqlhs
# is NXDOMAIN). Apply migrations 0001–0012 before first deploy.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Live keys, not test. Requires an approved account, which requires the
# /legal page to be publicly reachable first (terms, privacy, refunds,
# delivery, contact — all five are checked).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks. Used to verify HMAC signatures; a wrong
# value silently rejects every webhook, so subscriptions never activate.
RAZORPAY_WEBHOOK_SECRET=
# Subscription plan IDs created in the Razorpay dashboard. Amounts must match
# TIERS in src/config/brand.ts or customers are charged the wrong price.
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# ── SMS / phone OTP ──────────────────────────────────────────────────────────
# Configured in the Supabase dashboard (Auth → Providers → Phone), not here.
# This costs real money per message. Set a rate limit before launch or a
# scripted signup loop can run up a bill overnight.

# ── AI menu import ───────────────────────────────────────────────────────────
# Without this the importer returns clearly-labelled sample data instead of
# reading real photos.
ANTHROPIC_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Rewardly <noreply@yourdomain>

# ── Web push ─────────────────────────────────────────────────────────────────
# Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain

# ── WhatsApp (optional at launch) ────────────────────────────────────────────
# Needs Meta Business verification + an approved message template. Start that
# application early; the clock is Meta's, not yours. Leave blank to disable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANG=en

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=

# ── Image / video models (Yummy CAM upgrades) ───────────────────────────────
# Any provider works — swapping is an env change, not a code change.
# IMAGE_PROVIDER=fal | replicate | openai | stability
# Leave blank to keep the photo studio free-and-local only.
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=
